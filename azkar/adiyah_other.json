    {
        "_id": "614d0f028883584fd0936852",
        "category": "الدعاء لمن سببته",
        "count": "",
        "description": "",
        "reference": "",
        "zekr": "قَالَ النَّبِيُّ صلى الله عليه وسلم: ((اللَّهُمَّ فَأَيُّمَا مُؤْمِنٍ سَبَبْتُهُ فَاجْعَلْ ذَلِكَ لَهُ قُرْبَةً إِلَيْكَ يَوْمَ الْقِيَامَةِ)).",
        "published_at": "2021-09-23T23:34:25.186Z",
        "createdAt": "2021-09-23T23:34:26.667Z",
        "updatedAt": "2021-09-23T23:34:26.667Z",
