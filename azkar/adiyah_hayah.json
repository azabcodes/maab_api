    {
        "_id": "614d0f028883584fd09367fd",
        "category": "تهنئة المولود له وجوابه",
        "count": "",
        "description": "",
        "reference": "",
        "zekr": "((بَارَكَ اللَّهُ لَكَ فِي الْمَوْهُوبِ لَكَ، وَشَكَرْتَ الْوَاهِبَ، وَبَلَغَ أَشُدَّهُ، وَرُزِقْتَ بِرَّهُ)). وَيَرُدُّ عَلَيْهِ الْمُهَــــــنَّأُ فَيَقُولُ: ((بَارَكَ اللَّهُ لَكَ وَبَارَكَ عَلَيْكَ، وَجَزَاكَ اللَّهُ خَيْراً، وَرَزَقَكَ اللَّهُ مِثْلَهُ، وَأَجْزَلَ ثَوَابَكَ)).",
        "published_at": "2021-09-23T23:34:25.174Z",
        "createdAt": "2021-09-23T23:34:26.661Z",
        "updatedAt": "2021-10-01T12:24:34.857Z",
        "__v": 0,
        "id": "614d0f028883584fd09367fd"
    },
    {
        "_id": "614d0f028883584fd0936801",
        "category": "فضل عيادة المريض",
        "count": "",
        "description": "",
        "reference": "",
        "zekr": "قَالَ النَّبِيُّ صلى الله عليه وسلم: ((إِذَا عَادَ الرَّجُلُ أَخَاهُ الْمُسْلِمَ مَشَى فِي خِرَافَةِ الْجَنَّةِ حَتَّى يَجْلِسَ، فَإِذَا جَلَسَ غَمَرَتْهُ الرَّحْمَةُ، فَإِنْ كَانَ غُدْوَةً صَلَّى عَلَيْهِ سَبْعُونَ أَلْفَ مَلَكٍ حَتَّى يُمْسِيَ، وَإِنْ كَانَ مَسَاءً صَلَّى عَلَيْهِ سَبْعُونَ أَلْفَ مَلَكٍ حَتَّى يُصْبِحَ)).",
        "published_at": "2021-09-23T23:34:25.175Z",
        "createdAt": "2021-09-23T23:34:26.661Z",
        "updatedAt": "2021-09-23T23:34:26.661Z",
        "__v": 0,
        "id": "614d0f028883584fd0936801"
    },
    {
        "_id": "614d0f028883584fd0936802",
        "category": "دعاء المريض الذي يئس من حياته",
        "count": "",
        "description": "",
        "reference": "",
        "zekr": "((اللَّهُمَّ اغْفِرْ لِي، وَارْحَمْنِي، وَأَلْحِقْنِي بِالرَّفِيقِ الْأَعْلَى)).",
        "published_at": "2021-09-23T23:34:25.175Z",
        "createdAt": "2021-09-23T23:34:26.661Z",
        "updatedAt": "2021-09-23T23:34:26.661Z",
        "__v": 0,
        "id": "614d0f028883584fd0936802"
    },
    {
        "_id": "614d0f028883584fd0936803",
        "category": "دعاء المريض الذي يئس من حياته",
        "count": "",
        "description": "",
        "reference": "",
        "zekr": "((جَعَلَ النَّبِيُّ صلى الله عليه وسلم عِنْدَ مَوْتِهِ يُدْخِلُ يَدَيْهِ فِي الْمَاءِ فَيَمْسَحُ بِهِمَا وَجْهَهُ، وَيَقُولُ: لاَ إِلَهَ إِلاَّ اللَّهُ إِنَّ لِلْمَوْتِ سَكَرَاتٍ)).",
        "published_at": "2021-09-23T23:34:25.175Z",
        "createdAt": "2021-09-23T23:34:26.661Z",
        "updatedAt": "2021-09-23T23:34:26.661Z",
        "__v": 0,
        "id": "614d0f028883584fd0936803"
    },
    {
        "_id": "614d0f028883584fd0936804",
        "category": "دعاء المريض الذي يئس من حياته",
        "count": "",
        "description": "",
        "reference": "",
        "zekr": "((لاَ إِلَهَ إِلاَّ اللَّهُ وَاللَّهُ أَكْبَرُ، لاَ إِلَهَ إِلاَّ اللَّهُ وَحْدَهُ، لاَ إِلَهَ إِلاَّ اللَّهُ وَحْدَهُ لاَ شَرِيكَ لَهُ، لاَ إِلَهَ إِلاَّ اللَّهُ لَهُ المُلْكُ وَلَهُ الْحَمْدُ، لاَ إِلَهَ إِلاَّ اللَّهُ وَلاَ حَوْلَ وَلاَ قُوَّةَ إِلاَّ بِاللَّهِ)).",
        "published_at": "2021-09-23T23:34:25.175Z",
        "createdAt": "2021-09-23T23:34:26.662Z",
        "updatedAt": "2021-09-23T23:34:26.662Z",
        "__v": 0,
        "id": "614d0f028883584fd0936804"
    },
    {
        "_id": "614d0f028883584fd0936828",
        "category": "دعاء العطاس",
        "count": "",
        "description": "",
        "reference": "",
        "zekr": "((إِذَا عَطَسَ أَحَدُكُم فَلْيَقُلِ الْحَمْدُ لِلَّهِ، وَلْيَقُلْ لَهُ أَخُوهُ أَوْ صَاحِبُهُ: يَرْحَمُكَ اللَّهُ، فَإِذَا قَالَ لَهُ: يَرحَمُكَ اللَّهُ، فَلْيَقُلْ: يَهْدِيكُمُ اللَّهُ وَيُصْلِحُ بَالَكُمْ)).",
        "published_at": "2021-09-23T23:34:25.181Z",
        "createdAt": "2021-09-23T23:34:26.664Z",
        "updatedAt": "2021-09-23T23:34:26.664Z",
