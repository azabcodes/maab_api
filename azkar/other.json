    },
    {
        "_id": "614d0f028883584fd093684d",
        "category": "إفشاء السلام",
        "count": "",
        "description": "",
        "reference": "",
        "zekr": "((ثَلاَثٌ مَنْ جَمَعَهُنَّ فَقَدْ جَمَعَ الْإِيمَانَ: الْإِنْصَافُ مِنْ نَفْسِكَ، وَبَذْلُ السَّلاَمِ لِلْعَالَمِ، وَالْإِنْفَاقُ مِنَ الإِقْتَارِ)).",
        "published_at": "2021-09-23T23:34:25.186Z",
        "createdAt": "2021-09-23T23:34:26.667Z",
        "updatedAt": "2021-09-23T23:34:26.667Z",
        "__v": 0,
        "id": "614d0f028883584fd093684d"
    },
    {
        "_id": "614d0f028883584fd093684e",
        "category": "إفشاء السلام",
        "count": "",
        "description": "",
        "reference": "",
        "zekr": "وَعَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ رَضِيَ اللَّهُ عَنْهُمَا: أنَّ رَجُلاً سَأَلَ النَّبِيَّ صلى الله عليه وسلم أيُّ الْإِسْلاَمِ خَيْرٌ قَالَ: ((تُطْعِمُ الطَّعَامَ، وَتَقْرأُ السَّلاَمَ عَلَى مَنْ عَرَفْتَ وَمَنْ لَمْ تَعْرِفْ)).",
        "published_at": "2021-09-23T23:34:25.186Z",
        "createdAt": "2021-09-23T23:34:26.667Z",
        "updatedAt": "2021-09-23T23:34:26.667Z",
