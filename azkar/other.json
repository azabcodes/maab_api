        "category": "دعاء الرعد",
        "count": "",
        "description": "",
        "reference": "",
        "zekr": "((سُبْحَانَ الَّذِي يُسَبِّحُ الرَّعْدُ بِحَمْدِهِ وَالْمَلاَئِكةُ مِنْ خِيفَتِهِ)).",
